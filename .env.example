# Copy this file to .env and replace every <set-locally> value.
# Never commit .env or real credentials.

MARKETPULSE_ENVIRONMENT=local
MARKETPULSE_LOG_LEVEL=INFO
MARKETPULSE_PAPER_TRADING_ENABLED=true
MARKETPULSE_REAL_ORDER_EXECUTION_ENABLED=false

POSTGRES_DB=marketpulse
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=<set-locally>
POSTGRES_PORT=5432

MINIO_ROOT_USER=marketpulse
MINIO_ROOT_PASSWORD=<set-locally>
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MLFLOW_PORT=5000
