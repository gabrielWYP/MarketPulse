# Copy this file to .env and replace every <set-locally> value.
# Never commit .env or real credentials.

MARKETPULSE_ENVIRONMENT=local
MARKETPULSE_LOG_LEVEL=INFO
MARKETPULSE_PAPER_TRADING_ENABLED=true
MARKETPULSE_REAL_ORDER_EXECUTION_ENABLED=false
MARKETPULSE_BINANCE_USDM_BASE_URL=https://fapi.binance.com
MARKETPULSE_RAW_STORAGE_BACKEND=local
MARKETPULSE_RAW_STORAGE_ROOT=data/raw
MARKETPULSE_MINIO_ENDPOINT=localhost:9000
MARKETPULSE_MINIO_BUCKET=marketpulse
MARKETPULSE_MINIO_SECURE=false
MARKETPULSE_MINIO_ACCESS_KEY=
MARKETPULSE_MINIO_SECRET_KEY=

POSTGRES_DB=marketpulse
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=<set-locally>
POSTGRES_PORT=5432

MINIO_ROOT_USER=marketpulse
MINIO_ROOT_PASSWORD=<set-locally>
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MLFLOW_PORT=5000
